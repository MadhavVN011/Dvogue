# Optional public storefront configuration. Local deploys auto-write .dvogue/deployment.json.
# All DVOGUE_* settings below are publicly exposed through /api/network.
# Use a browser-accessible public RPC without secret tokens. Restart after environment changes.
DVOGUE_CHAIN_ID=31337
DVOGUE_CHAIN_NAME=Dvogue Local
DVOGUE_CURRENCY=ETH
DVOGUE_RPC_URL=http://127.0.0.1:8545
DVOGUE_REGISTRY_ADDRESS=
DVOGUE_MARKET_ADDRESS=
DVOGUE_EXPLORER_URL=
DVOGUE_TESTNET=true

# Server-side deployment settings. External deployments require an explicit private key.
# NEVER put secrets in DVOGUE_* or NEXT_PUBLIC_* variables.
DEPLOY_RPC_URL=http://127.0.0.1:8545
DEPLOYER_PRIVATE_KEY=
CATALOG_BASE_URL=http://localhost:3000
# Optional: resume an interrupted deployment with the addresses it printed.
DEPLOY_REGISTRY_ADDRESS=
DEPLOY_MARKET_ADDRESS=
