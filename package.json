{
  "name": "dvogue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/domain.test.js && npm run contracts:test",
    "test:browser": "playwright test",
    "contracts:compile": "node scripts/compile.js",
    "contracts:test": "node test.js",
    "contracts:node": "anvil --host 127.0.0.1 --port 8545 --chain-id 31337",
    "contracts:deploy": "node scripts/deploy.js",
    "check": "npm run lint && npm test && npm run build",
    "wallet:fund": "node scripts/fund-wallet.js"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "ethers": "6.17.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@playwright/test": "1.65.1",
    "dotenv": "18.0.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "solc": "0.8.39"
  },
  "overrides": {
    "tmp": "0.2.7",
    "zod": "4.6.7"
  }
}
